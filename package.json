{
  "name": "innobox",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Enterprise challenge & solution management platform, anchored in Microsoft Entra ID.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @innobox/web test:db",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
