{
  "name": "@innobox/shared",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./avatars": {
      "types": "./dist/avatars.d.ts",
      "default": "./dist/avatars.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./email-template": {
      "types": "./dist/email-template.d.ts",
      "default": "./dist/email-template.js"
    },
    "./system-log": {
      "types": "./dist/system-log.d.ts",
      "default": "./dist/system-log.js"
    },
    "./audit-browser": {
      "types": "./dist/audit-browser.d.ts",
      "default": "./dist/audit-browser.js"
    },
    "./system-banner": {
      "types": "./dist/system-banner.d.ts",
      "default": "./dist/system-banner.js"
    },
    "./notification-preferences": {
      "types": "./dist/notification-preferences.d.ts",
      "default": "./dist/notification-preferences.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && cd dist && node --test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "sanitize-html": "^2.18.0"
  }
}
