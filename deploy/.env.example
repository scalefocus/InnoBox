# InnoBox deployment configuration (INNOBOX_SPEC.md §2.3).
# Copy to .env and fill in. NEVER commit .env. Secrets are injected at runtime only.

# --- Public URL (OIDC redirects + e-mail deep links) ---
# The deployment's own canonical URL — no host is pinned in the repository (INNOBOX_SPEC.md §2.3).
PUBLIC_BASE_URL=https://innobox.example.com

# --- Postgres ---
POSTGRES_USER=innobox
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=innobox
# Least-privilege app role password (web/worker connect as innobox_app)
INNOBOX_APP_PASSWORD=change-me-strong-app

# --- Next.js / Auth.js ---
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Microsoft Entra ID (OIDC SSO — see ENTRA_AUTH_SPEC.md) ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-entra-app-client-secret

# --- Bootstrap first Platform Admin (Entra group object id) ---
# Members of this group are Platform Admins from first boot (chicken-and-egg fix).
INNOBOX_BOOTSTRAP_ADMIN_GROUP=00000000-0000-0000-0000-000000000000

# --- SCIM provisioning (Entra Enterprise App -> worker /scim/v2) ---
# Bearer token Entra presents on every SCIM request. Treat as a secret.
SCIM_BEARER_TOKEN=generate-a-long-random-token

# --- Object storage (MinIO bundled; or point at real S3) — INNOBOX_SPEC.md §11 ---
MINIO_ROOT_USER=innobox
MINIO_ROOT_PASSWORD=change-me-strong-minio
# Attachment bucket (web WRITES uploads, worker READS them for the ClamAV scan). Must match
# across web + worker. Created automatically on first use if it doesn't exist.
S3_BUCKET=innobox-attachments
# S3 endpoint + region. In the bundled stack the compose file already wires S3_ENDPOINT for the
# containers; set these only when pointing at a non-compose MinIO or a real S3.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# Credentials the web/worker use to reach object storage. If unset they DEFAULT to the MinIO
# root creds above (dev convenience). Point at dedicated S3 keys for production.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- ClamAV virus scanning (worker scan sweep — INNOBOX_SPEC.md §11) ---
# clamd daemon address. In the bundled stack the compose file sets these for the worker; the
# defaults below match the compose service. Leave unset outside compose to disable scanning.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- Dev/e2e auth bypass (INNOBOX_SPEC.md §2.3) ---
# Enables the Playwright/dev credentials sign-in. MUST NEVER be set in production —
# checking it is part of the deploy env review.
# INNOBOX_DEV_AUTH=

# --- Reverse-proxy client IP ---
# Passed to Express `trust proxy` on the worker so audit records show the real client IP
# instead of the proxy's: a hop count ("1"), "true"/"false", a preset ("loopback"), or a
# comma-separated subnet list. UNSET = don't trust X-Forwarded-For.
# TRUST_PROXY=1

# --- Observability ---
# If set, GET /metrics on web + worker requires "Authorization: Bearer <token>".
# Leave unset to expose metrics unauthenticated on the internal network.
# METRICS_TOKEN=

# --- Notification delivery (INNOBOX_SPEC.md §12; the in-app inbox always works) ---
# Graph e-mail service account (primary transport): a platform admin connects the
# Microsoft 365 service mailbox (e.g. innobox@example.com) from the Administration page.
# Requires the key below (encrypts stored OAuth tokens; 32 bytes base64 — generate with
# `openssl rand -base64 32`) AND a dedicated "InnoBox Email" Entra app registration
# (ENTRA_AUTH_SPEC.md §3.2) with delegated Mail.Send + offline_access, Assignment required =
# Yes (only the service mailbox user assigned), and the redirect URI
# <PUBLIC_BASE_URL>/api/admin/email/callback.
# This MUST be a separate app registration from the OIDC app (ENTRA_CLIENT_ID) so that
# Mail.Send is not exercisable on behalf of regular users.
# EMAIL_TOKEN_ENC_KEY=
# ENTRA_EMAIL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_EMAIL_CLIENT_SECRET=your-email-app-client-secret
# SMTP: the fallback e-mail transport (plain-text) when no Graph account is operational.
# Leave SMTP_HOST unset to disable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0            # 1 for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# Sender address for the SMTP fallback. No default is baked into the app: when unset it falls
# back to SMTP_USER, and with neither set the SMTP transport stays disabled (§2.3).
# SMTP_FROM=innobox@example.com
